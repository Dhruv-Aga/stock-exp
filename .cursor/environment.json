{
  "name": "Bharat Scout / India Trading Bot",
  "install": "./.cursor/install.sh",
  "terminals": [
    {
      "name": "frontend",
      "command": "python3 -m http.server 8080 --bind 0.0.0.0"
    },
    {
      "name": "kite-proxy",
      "command": "cd server && npm start"
    }
  ],
  "ports": [
    { "name": "frontend", "port": 8080 },
    { "name": "kite-proxy", "port": 3000 }
  ]
}
