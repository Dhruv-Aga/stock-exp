# Copy to .env and fill in. See SETUP.md and docs/SECURITY.md.

# Email (optional reports)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM=your@gmail.com
EMAIL_TO=your@gmail.com

# Zerodha Kite Connect — Personal (free) tier is enough for order placement.
# https://developers.kite.trade/
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# TOTP auto-login (no daily browser paste). Use base32 secret from 2FA setup.
ZERODHA_USER_ID=
ZERODHA_PASSWORD=
ZERODHA_TOTP_SECRET=

# Local API protection (auto-generated by ./scripts/dev.sh setup)
BHARAT_SCOUT_API_KEY=

# Trading mode
LIVE_TRADING=false
REQUIRE_TRADE_APPROVAL=true
AUTO_APPROVE_TRADES=false
SHADOW_LIVE_PROPOSALS=true
CASH_ONLY=true
MAX_DAILY_LOSS=2000
KILL_SWITCH=false
ORDER_TAG=india-bot

# LLM risk governor (Groq) + in-app assistant
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_RISK_GOVERNOR=true

# Local dev — default localhost; use HOST_BIND=0.0.0.0 only on trusted home Wi‑Fi
HOST_BIND=127.0.0.1
FRONTEND_PORT=8080
AGENT_API_PORT=8000
KITE_PROXY_PORT=3000
# START_KITE_PROXY=1
# CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
