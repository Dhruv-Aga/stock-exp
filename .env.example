# Copy to .env and fill in. See SETUP.md for full guide.

# Email (configured for dhruvaga11@gmail.com)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM=your@gmail.com
EMAIL_TO=your@gmail.com

# Zerodha - add after 1-month paper review
# https://developers.kite.trade/
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# Trading mode
LIVE_TRADING=false
REQUIRE_TRADE_APPROVAL=true
SHADOW_LIVE_PROPOSALS=true
CASH_ONLY=true
MAX_DAILY_LOSS=2000
KILL_SWITCH=false
ORDER_TAG=india-bot

# LLM risk governor (Groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_RISK_GOVERNOR=true
